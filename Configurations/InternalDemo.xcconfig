#include "Common.xcconfig"

// Preserve the installed Demo identity and its local application container.
CAPYDOKU_ENVIRONMENT = internal_demo
CAPYDOKU_APP_BUNDLE_IDENTIFIER = com.capydoku.demo
CAPYDOKU_APP_DISPLAY_NAME = Capydoku
CAPYDOKU_REMOTE_CONFIGURATION_ENABLED = NO
CAPYDOKU_REMOTE_CONFIGURATION_ENVIRONMENT = internal_demo
CAPYDOKU_REMOTE_CONFIGURATION_URL =
// Consent-gated local queue only; no analytics SDK or upload.
CAPYDOKU_ANALYTICS_ENABLED = YES
